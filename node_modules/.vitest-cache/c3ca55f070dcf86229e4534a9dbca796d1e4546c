  beforeEach(() => {
    process.env.SMARTDOOR_API_KEY = API_KEY;
    db = createDatabase(':memory:');
    client = new FakeClient();
    feedEvents = [];
    const liveFeed = { broadcast: (e) => feedEvents.push(e), alert: (e) => feedEvents.push(e) };
    svc = createMqttService({ client, db, liveFeed, env: process.env });
